{
  // Copie para wrangler.jsonc e substitua o ID pelo D1 da SUA conta.
  "name": "meritus-estudantil",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "rules": [{"type":"ESModule","globs":["**/*.js","**/*.mjs"]}],
  "assets": {"directory":"dist/client"},
  "d1_databases": [{"binding":"DB","database_name":"meritus-db","database_id":"SUBSTITUA-PELO-ID-RETORNADO"}]
}
