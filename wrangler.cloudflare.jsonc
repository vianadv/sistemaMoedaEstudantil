{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meritus-estudantil",
  "main": "dist/cloudflare/index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "no_bundle": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": [
        "**/*.js",
        "**/*.mjs"
      ]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "meritus-db",
      "database_id": "6446e008-373b-42bf-a03a-4fada014194d"
    }
  ]
}
