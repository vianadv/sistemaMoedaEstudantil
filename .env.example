# Um remetente do sistema envia para os endereços cadastrados. Nunca comitar valores reais.
# Opção Gmail (não exige Resend nem domínio próprio):
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Opção Resend (usada quando não há configuração Gmail):
RESEND_API_KEY=
EMAIL_FROM=Meritus <contato@seu-dominio-verificado.com>
PORT=3000
DB_PATH=./data/meritus.sqlite
