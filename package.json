{
  "name": "meritus-moeda-estudantil",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema acadêmico de moeda estudantil com MVC e DAO.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.mjs",
    "demo": "node server.mjs",
    "dev": "node --watch server.mjs",
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/build.mjs",
    "db:generate": "drizzle-kit generate",
    "deploy": "wrangler deploy --config wrangler.cloudflare.jsonc"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "esbuild": "0.28.0",
    "wrangler": "4.92.0"
  }
}
